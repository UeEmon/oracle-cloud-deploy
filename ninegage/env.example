# Copy to .env next to compose.yaml on Nine-Gage's VM.
# Without your own domain, use this VM's reserved public IP with dashes: 203-0-113-20.sslip.io
# Production is https://<NINEGAGE_DOMAIN>, staging https://staging.<NINEGAGE_DOMAIN>.
NINEGAGE_DOMAIN=
# Pin production to a release (e.g. 0.2.0) only while rolling back; empty means the latest release (stable).
NINEGAGE_TAG=
# Pin the papercraft generator to a release only while rolling back; empty means stable.
PAPERCRAFT_TAG=
# Backups (bin/backup.sh): Object Storage bucket, folder and how many days to keep.
BACKUP_BUCKET=chuck-backups
BACKUP_PREFIX=ninegage
BACKUP_KEEP_DAYS=14
