# Certificates come from Let's Encrypt automatically.
# NINEGAGE_DOMAIN is the VM's <IP with dashes>.sslip.io until the owner has a domain; then only .env changes.

# No framing, scripts and data only from itself (Next.js needs inline scripts and styles),
# drawings and recordings as data:/blob:.
(ninegage_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
		-X-Powered-By
	}
}

# Production: one app on two addresses (the app tells them apart by Host, src/proxy.ts in Nine-Gage-Systems).
# www = the top page with login, sign-up and account; platform = the editor. Anyone may open the editor and sign up.
www.{$NINEGAGE_DOMAIN}, platform.{$NINEGAGE_DOMAIN} {
	encode gzip
	import ninegage_headers
	request_body {
		max_size 2MB
	}
	reverse_proxy nine-gage:3000
}

# The bare domain: the top page for /, the platform for every other path (the editor's address until 2026-11-25).
{$NINEGAGE_DOMAIN} {
	import ninegage_headers
	@top path /
	handle @top {
		redir https://www.{$NINEGAGE_DOMAIN}/ permanent
	}
	handle {
		redir https://platform.{$NINEGAGE_DOMAIN}{uri} permanent
	}
}

# Staging (the latest main) behind its own password, kept out of search engines.
staging.{$NINEGAGE_DOMAIN} {
	basic_auth {
		{$NINEGAGE_STAGING_USER} {$NINEGAGE_STAGING_PASSWORD_HASH}
	}
	encode gzip
	import ninegage_headers
	header X-Robots-Tag "noindex, nofollow"
	request_body {
		max_size 2MB
	}
	reverse_proxy nine-gage-staging:3000
}

# The terminal (layout sharing; formerly みんなのレイアウト). Logins come from production (SenroLab accounts); anyone may browse.
terminal.{$NINEGAGE_DOMAIN} {
	encode gzip
	import ninegage_headers
	request_body {
		max_size 3MB
	}
	reverse_proxy terminal:3100
}

# The old address from before the rename (share → terminal, 2026-11-24): keep old links working.
share.{$NINEGAGE_DOMAIN} {
	import ninegage_headers
	redir https://terminal.{$NINEGAGE_DOMAIN}{uri} permanent
}

# The addresses before senrolab.com (until 2026-11-25): keep old links working.
138-3-216-172.sslip.io {
	redir https://platform.{$NINEGAGE_DOMAIN}{uri} permanent
}

staging.138-3-216-172.sslip.io {
	redir https://staging.{$NINEGAGE_DOMAIN}{uri} permanent
}

terminal.138-3-216-172.sslip.io, share.138-3-216-172.sslip.io {
	redir https://terminal.{$NINEGAGE_DOMAIN}{uri} permanent
}
