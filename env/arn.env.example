# Copy to env/arn.env. 要件ナビ reads this file (see its .env.example for every option).
NODE_ENV=production
AUTH_MODE=local
# Required by the first-admin setup screen, so nobody else can claim the new site.
LOCAL_SETUP_TOKEN=
# 32 random bytes, base64. Keep a copy elsewhere: losing it makes stored AI keys unreadable.
#   docker run --rm node:22-alpine node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
PUBLIC_URL=https://
ARN_VERSION=main
