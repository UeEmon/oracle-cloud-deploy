# Copy to .env next to compose.yaml on the VM.
# Without your own domain, use the reserved public IP with dashes: 203-0-113-10.sslip.io
# The CHUCK admin site is admin.<CHUCK_DOMAIN>.
CHUCK_DOMAIN=
ARN_DOMAIN=
CHUCK_USER=chuck
# docker run --rm caddy:2.8.4 caddy hash-password --plaintext '<password>'
# Keep the single quotes: the hash contains $ characters.
CHUCK_PASSWORD_HASH=''
# CHUCK admin site: the proxy sends this to the app (openssl rand -hex 32).
CHUCK_ADMIN_SECRET=
# Donations through GitHub Sponsors (see the app's docs/SPONSORS_SETUP.md).
CHUCK_DONATION_URL=https://github.com/sponsors/UeEmon
GITHUB_SPONSORS_WEBHOOK_SECRET=
# Fixed part of the meter goal in USD (domain and so on); bin/update-cost.sh adds the Oracle bill daily.
CHUCK_MONTHLY_COST_USD=0
# Yen per dollar for converting a JPY bill.
CHUCK_JPY_PER_USD=150
# Backups (bin/backup.sh): Object Storage bucket and how many days to keep.
BACKUP_BUCKET=chuck-backups
BACKUP_KEEP_DAYS=14
