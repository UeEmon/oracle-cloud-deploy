# Certificates for every site are obtained from Let's Encrypt automatically.

# CHUCK public edition: anyone may use it. The admin header is always removed
# here, so visitors cannot claim to be the administrator.
# Host is passed through unchanged, which CHUCK's same-origin checks need.
{$CHUCK_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	reverse_proxy hf-propagation:8000 {
		header_up -X-Chuck-Admin
	}
}

# CHUCK admin site: Basic auth, then the admin header the app trusts.
admin.{$CHUCK_DOMAIN} {
	basic_auth {
		{$CHUCK_USER} {$CHUCK_PASSWORD_HASH}
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	reverse_proxy hf-propagation:8000 {
		header_up X-Chuck-Admin {$CHUCK_ADMIN_SECRET}
	}
}

# CHUCK public-data fetcher: only its admin page (own password, HF_PUBLIC_DATA_UI_PASSWORD).
# The token-protected /api/* that CHUCK reads stays inside; Host is passed through for the same-origin check.
data.{$CHUCK_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	@admin path / /public-data.js /briefing.js /briefing-messages.js /style.css /i18n.js /i18n-messages.js /chuck-icon.png /favicon.png /ui/*
	handle @admin {
		reverse_proxy public-data:8002
	}
	handle {
		respond 404
	}
}

# CHUCK position gateway: only its admin page (own password, HF_GATEWAY_UI_PASSWORD).
# The token-protected position APIs (/api/*, /internal/*) stay inside; devices send NMEA to TCP/UDP 10120.
# Host is passed through for the same-origin check.
gateway.{$CHUCK_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	@admin path / /gateway.js /style.css /i18n.js /i18n-messages.js /chuck-icon.png /favicon.png /ui/*
	handle @admin {
		reverse_proxy position-gateway:8001
	}
	handle {
		respond 404
	}
}

# CHUCK gateway simulator control panel: no login of its own, so it sits behind the CHUCK admin password.
# Host is passed through; the panel answers only to this name (--allow-host).
sim.{$CHUCK_DOMAIN} {
	basic_auth {
		{$CHUCK_USER} {$CHUCK_PASSWORD_HASH}
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	reverse_proxy gateway-simulator:8090
}

# 要件ナビ has its own login (AUTH_MODE=local in env/arn.env).
{$ARN_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy {$ARN_UPSTREAM}
}

# BACCHUS: the personal stock stays in the browser; the shared stock needs a token from env/bacchus.env.
bacchus.{$CHUCK_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy bacchus:8000
}

# 海日和: static assets only; shares the existing admin password per deployment policy.
weather.{$CHUCK_DOMAIN} {
 basic_auth {
  {$CHUCK_USER} {$CHUCK_PASSWORD_HASH}
 }
 encode gzip
 header {
  Strict-Transport-Security "max-age=31536000"
  X-Content-Type-Options nosniff
  Referrer-Policy same-origin
  -Server
 }
 root * /srv/openweather
 @assets path / /index.html /style.css /app.js /weather.mjs
 handle @assets {
  file_server
 }
 handle {
  respond 404
 }
}
