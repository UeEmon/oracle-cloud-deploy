# Certificates for every site are obtained from Let's Encrypt automatically.

# CHUCK public edition: anyone may use it. The admin header is always removed
# here, so visitors cannot claim to be the administrator.
# Host is passed through unchanged, which CHUCK's same-origin checks need.
{$CHUCK_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	reverse_proxy hf-propagation:8000 {
		header_up -X-Chuck-Admin
	}
}

# CHUCK admin site: Basic auth, then the admin header the app trusts.
admin.{$CHUCK_DOMAIN} {
	basic_auth {
		{$CHUCK_USER} {$CHUCK_PASSWORD_HASH}
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	reverse_proxy hf-propagation:8000 {
		header_up X-Chuck-Admin {$CHUCK_ADMIN_SECRET}
	}
}

# 要件ナビ has its own login (AUTH_MODE=local in env/arn.env).
{$ARN_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy {$ARN_UPSTREAM}
}

# HACS has no login of its own, so it sits behind the CHUCK admin password.
hacs.{$CHUCK_DOMAIN} {
	basic_auth {
		{$CHUCK_USER} {$CHUCK_PASSWORD_HASH}
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	reverse_proxy hacs:8787
}

hacs-rx.{$CHUCK_DOMAIN} {
	basic_auth {
		{$CHUCK_USER} {$CHUCK_PASSWORD_HASH}
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	reverse_proxy receiver:8788
}

# eNMEA2000 signs in with its own APP_TOKEN (env/enmea.env).
nmea.{$CHUCK_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy enmea-web:80
}

# BACCHUS: the personal stock stays in the browser; the shared stock needs a token from env/bacchus.env.
bacchus.{$CHUCK_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy bacchus:8000
}
