# Copy to .env next to compose.yaml on papercraft-1.
# This VM's private IP in subnet papercraft-public (10.0.2.0/24), e.g. 10.0.2.10. Nine-Gage calls http://<it>:8080.
PAPERCRAFT_BIND_IP=
# Pin to a release (e.g. 0.1.0) only while rolling back; empty means the latest release (stable).
PAPERCRAFT_TAG=
